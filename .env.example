# Fictitious credentials for local development. Copy this file to .env.
# These PostgreSQL values initialize a NEW volume; changing them does not reset one.
POSTGRES_USER=credit_simulation
POSTGRES_PASSWORD=credit_simulation
POSTGRES_DB=credit_simulation
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# API running on the host: local addresses of the published bank ports.
# Compose supplies the internal service names and PostgreSQL port automatically.
BANK_A_BASE_URL=http://localhost:3001
BANK_B_BASE_URL=http://localhost:3002
BANK_TIMEOUT_SECONDS=5

# Ports published by Compose, restricted to the local machine.
CREDIT_API_PORT=8000
BANK_A_PORT=3001
BANK_B_PORT=3002

# JSON array of explicit origins; update ports if the frontend/API ports change.
# localhost:8000 also permits requests from the local API documentation page.
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:8000"]
# Set true when serving the application over HTTPS.
SESSION_COOKIE_SECURE=false
